<?xml version="1.0" encoding="utf-8"?>
<form>
	<author>FLEXIcontent Team</author>
	<website>www.flexicontent.org</website>
	<email>info@flexicontent.org</email>
	<license>GPLv3</license>
	<version>2</version>
	<release>09 09 2026</release>
	<microdata_support>0</microdata_support>

	<defaulttitle>GrapesJS Item Layout</defaulttitle>
	<description>Item layout edited with the FlexiContent Layout Builder (GrapesJS), rendered at runtime by resolving flexi_field / flexi_link / flexi_item placeholders</description>

	<fields name="attribs">
		<fieldset name="attribs" addfieldpath="/administrator/components/com_flexicontent/elements">

			<field name="params_builder_info" type="separator" cssprep="1" not_inherited="1" default="Layout Builder (GrapesJS)" description="" level="level2" class="alert alert-info" />

			<field name="builder_layout1" type="fclayoutbuilder" default="" label="Layout builder" description="" class=""
				not_inherited="1"
				editor_sfx="builder_layout1"
				lessfile="components/com_flexicontent/builder/less/builder_layout1_{{folder}}.less"
			/>
			<field name="builder_layout1_html" type="textarea" filter="raw" readonly="readonly" rows="2" default="" label="HTML" description="" class="input-xxlarge" not_inherited="1"/>
			<field name="builder_layout1_js" type="hidden" filter="raw" default="" label="JS" description="" class="" not_inherited="1" />
			<field name="builder_layout1_css" type="textarea" readonly="readonly" filter="raw" rows="2" default="" label="CSS" description="" class="input-xxlarge" not_inherited="1" />
			<field name="builder_layout1_data" type="hidden" filter="raw" default="" label="Project data" description="" class="" not_inherited="1"/>
			<field name="builder_layout1_hash" type="hidden" filter="JHtmlFclayoutbuilder::createUrlHash" default="" label="Hash" description="" class="" not_inherited="1" />
			<field name="builder_layout1_less" type="hidden" filter="JHtmlFclayoutbuilder::prepareLess" default="components/com_flexicontent/builder/less/builder_layout1_{{folder}}" label="LESS" description="" class="" not_inherited="1" />

		</fieldset>
	</fields>

	<fieldgroups>

		<group posrow="subtitle" tcolor="darkcyan" title="After Title row 1">subtitle1</group>
		<group posrow="subtitle" tcolor="darkcyan" title="After Title row 2">subtitle2</group>
		<group posrow="subtitle" tcolor="darkcyan" title="After Title row 3">subtitle3</group>

		<group posrow="img_top" tcolor="#3A2459" title="Top">top</group>
		<group tcolor="#000000" title="Description">description</group>

		<group tcolor="#6C1A10" title="Bottom">bottom</group>

		<group tcolor="darkgray" title="Render only, no display">renderonly</group>

	</fieldgroups>

</form>